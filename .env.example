COMPOSE_PROJECT_NAME=eu-funding-tenders-portal-agent

# Bearer token clients use to call this agent
API_KEY=

# OpenAI-compatible LLM endpoint (LiteLLM gateway)
AGENT_API_KEY=
# AGENT_MODEL=AarhusAI-default-v2
# AGENT_API_BASE_URL=http://litellm.itkdev.dk/v1
# AGENT_TIMEOUT=60

# EU Funding & Tenders Portal (SEDIA search API). The defaults point at the
# public production endpoint and need no credentials — "SEDIA" is the literal
# apiKey the portal frontend itself uses.
# PORTAL_SEARCH_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
# PORTAL_API_KEY=SEDIA

# Which language's copy of each topic to retrieve, as a JSON array. The index
# holds each topic in up to 24 languages, but they are not real translations —
# body text is English regardless — and coverage varies a lot: "en" has 970
# Forthcoming/Open Horizon+Digital topics, "da" only 536. A list acts as a
# preference order with per-topic fallback, e.g. ["da","en"].
# PORTAL_LANGUAGES=["en"]

# How long the in-memory topic corpus is reused before refetching, in seconds
# (default 6h). The corpus lives in the process heap only: it is dropped on
# restart and on every --reload in dev.
# PORTAL_CACHE_TTL=21600

# Safety cap on pagination. The default profile needs 10 pages of 100; the cap
# stops a widened profile from fetching indefinitely.
# PORTAL_MAX_PAGES=20

# Host-header allowlist for the MCP (/mcp) endpoint, as a JSON array. Setting
# this turns on DNS-rebind protection: a request whose Host header isn't listed
# is rejected with 421. ":*" matches any port. Add your reverse proxy's
# forwarded Host when deploying behind one. Defaults are applied if unset.
# MCP_ALLOWED_HOSTS=["eu-funding-tenders-portal-agent:*","localhost:*"]

# DEBUG=false
