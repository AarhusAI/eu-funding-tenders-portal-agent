COMPOSE_PROJECT_NAME=eu-funding-tenders-portal-agent

# Bearer token clients use to call this agent
API_KEY=

# OpenAI-compatible LLM endpoint (LiteLLM gateway)
AGENT_API_KEY=
# AGENT_MODEL=AarhusAI-default-v2
# AGENT_API_BASE_URL=http://litellm.itkdev.dk/v1

# Two independent limits bound a single agent run. AGENT_TIMEOUT is wall clock;
# AGENT_MAX_ITERATIONS is a tool-call budget that stops a model which keeps
# searching instead of answering. Hitting either is not an error — the tools
# have already written their results, so the caller still gets topics.
# AGENT_TIMEOUT=60
# AGENT_MAX_ITERATIONS=8

# Replaces the built-in system prompt WHOLESALE. The default carries the
# tool-calling workflow, so an override that omits it stops the agent calling
# search_topics at all. Start from the text in app/services/agent.py.
# AGENT_SYSTEM_PROMPT=

# Default page size for /search and the MCP tool, and the ceiling both clamp to.
# AGENT_MAX_RESULTS=10
# AGENT_MAX_RESULTS_CAP=50

# How much of each description the LLM sees per topic. The full text still
# reaches the caller through the side channel; this only bounds token spend.
# AGENT_PREVIEW_CHARS=300

# MCP-only compaction. A chat client replays every tool result into the model's
# context on each turn, so the MCP path trims what REST /search returns in full.
# MCP_MAX_DESCRIPTION_CHARS=400
# MCP_MAX_KEYWORDS=10

# EU Funding & Tenders Portal (SEDIA search API). The defaults point at the
# public production endpoint and need no credentials — "SEDIA" is the literal
# apiKey the portal frontend itself uses.
# PORTAL_SEARCH_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
# PORTAL_API_KEY=SEDIA

# Extra name -> Portal id mappings, merged over the verified built-ins in
# app/services/profile.py, so a newly published programme is an env var rather
# than a release. Keys match case-insensitively. Must be valid JSON objects.
# PORTAL_PROGRAMME_IDS={"Creative Europe":"12345678"}
# PORTAL_STATUS_IDS={}

# Which language's copy of each topic to retrieve, as a JSON array. NOT a
# translation setting — use the request's `language` field for the reply
# language. This picks which language copy is indexed, and coverage varies a
# lot: "en" has 970 Forthcoming/Open Horizon+Digital topics, "da" only 536. A
# list acts as a preference order with per-topic fallback, e.g. ["da","en"].
# PORTAL_LANGUAGES=["en"]

# How long the topic corpus is reused before refetching, in seconds (default 6h).
# PORTAL_CACHE_TTL=21600

# Safety cap on pagination. The default profile needs 10 pages of 100; the cap
# stops a widened profile from fetching indefinitely.
# PORTAL_MAX_PAGES=20

# Where the trimmed topic corpus is cached.
#   memory   (default) process heap — per-worker, dropped on restart
#   redis    shared across instances and across restarts; `task up:redis`
#   disabled every search refetches (debugging only)
# A Redis outage degrades to slow searches, never failed ones: the backend
# fails open. Measured: cold fetch ~11s, warm ~0.02s, ~4.2 MB per corpus.
# CACHE_BACKEND=memory
# CACHE_REDIS_URL=redis://redis:6379/0

# Host-header allowlist for the MCP (/mcp) endpoint, as a JSON array. Setting
# this turns on DNS-rebind protection: a request whose Host header isn't listed
# is rejected with 421. ":*" matches any port. Add your reverse proxy's
# forwarded Host when deploying behind one. Defaults are applied if unset.
# MCP_ALLOWED_HOSTS=["eu-funding-tenders-portal-agent:*","localhost:*"]

# DEBUG=false
